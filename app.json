{
  "expo": {
    "name": "STH Toewijzing Assistent",
    "slug": "sth-toewijzing-assistent",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1B5E8A"
    },
    "plugins": [
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Toegang tot de microfoon is nodig voor spraakbesturing bij het schrijven van toewijzingen.",
          "speechRecognitionPermission": "Spraakherkenning wordt gebruikt om uw gesproken tekst om te zetten naar tekst in de toewijzing."
        }
      ]
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "nl.sthelmond.toewijzing",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1B5E8A"
      },
      "package": "nl.sthelmond.toewijzing",
      "versionCode": 1,
      "permissions": ["android.permission.RECORD_AUDIO"],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "emailjsServiceId": "",
      "emailjsTemplateId": "",
      "emailjsPublicKey": ""
    }
  }
}
