# Kopieer dit bestand naar .env en vul jouw waarden in
PORT=3001

# Nefit / Bosch EasyControl
# Serienummer staat op de cv-ketel (bijv. "123456789")
NEFIT_SERIAL=123456789
# Access key staat in de Nefit Easy app: Instellingen > Serienummer/toegangscode
NEFIT_ACCESS_KEY=xx-xxxx-xx
NEFIT_PASSWORD=jouwwachtwoord
