# Anthropic API-sleutel voor de STH Toewijzing Assistent
# Maak een account aan op https://console.anthropic.com
# Kopieer dit bestand naar .env en vul uw API-sleutel in.
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# EmailJS configuratie (niet meer in gebruik)
EMAILJS_SERVICE_ID=service_xxxxxxx
EMAILJS_TEMPLATE_ID=template_xxxxxxx
EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxxxx
